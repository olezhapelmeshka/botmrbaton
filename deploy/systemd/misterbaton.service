[Unit]
Description=Mr. Baton Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/misterbaton
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/misterbaton/.venv/bin/python bot/main.py
Restart=always
RestartSec=10
UMask=0077

# Allow writing runtime data under the project tree
ReadWritePaths=/opt/misterbaton

[Install]
WantedBy=multi-user.target
