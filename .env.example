# Telegram Bot Token (от @BotFather)
TELEGRAM_BOT_TOKEN=

# Anthropic API (через любой совместимый прокси)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# OpenAI / ZhipuAI GLM models (через OpenAI‑совместимый эндпоинт)
#
# Для использования моделей семейства GLM (например `glm-4.5-flash`) через
# сервисы OpenRouter или ZhipuAI укажите ваш ключ и базовый URL. Эти
# значения аналогичны параметрам `api_key` и `base_url` при инициализации
# клиента OpenAI SDK. Пример base_url для OpenRouter: https://openrouter.ai/api/v1
#
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Имя модели по умолчанию для вызовов через OpenAI SDK (GLM‑4.5‑Flash)
OPENAI_MODEL=glm-4.5-flash

# ---- Опциональный отдельный endpoint для Vision (картинки) ----
# Если заполнено — при получении фото бот шлёт изображения именно сюда
# (полезно, когда основной провайдер — текстовый GLM, а для зрения хочется Gemini / GPT-4o / Claude).
# Пример: OpenRouter, официальный Gemini OpenAI-compat, или свой vLLM.
OPENAI_VISION_API_KEY=
OPENAI_VISION_BASE_URL=          # например https://openrouter.ai/api/v1
OPENAI_VISION_MODEL=             # например gemini-2.5-flash или gpt-4o-mini
# -----

# МОДЕЛИ
# Для полноценного использования GLM‑4.5‑Flash в боте мы рекомендуем
# установить обе модели на одно и то же значение. Если вы хотите
# переключаться между Claude и GLM, можно указать разные модели.
MODEL_FAST=glm-4.5-flash
MODEL_SMART=glm-4.5-flash

# Параметры генерации
# Лимиты токенов для запроса и для сложных задач. Для GLM-4.5-Flash
# безопасные значения — 1024 и 2048 токенов соответственно.
MAX_TOKENS=1024
MAX_TOKENS_DOC=2048
TEMPERATURE=0.6

# Память и лимиты контекста (сильно влияют на то, как бот отвечает)
#
# HISTORY_ROUNDS — сколько полных раундов храним для тяжёлого agent-пути.
# MAX_HISTORY_MESSAGES_PER_CHAT — сколько последних сообщений показываем
#   в "[context] recent chat history" на каждом запросе.
#   8 = хорошо помнит, но часто зацикливается на своих старых шутках.
#   5 = рекомендуется для семейных групп (меньше повторяет старые мемы).
#   4 = очень короткая память, бот почти не помнит предыдущие реплики.
#
# Если бот зацикливается на одной и той же шутке из прошлого — снижай
# MAX_HISTORY_MESSAGES_PER_CHAT до 5 или 4.
HISTORY_ROUNDS=10
MAX_HISTORY_MESSAGES_PER_CHAT=8
# Ограничение общей длины контекста (символы). Z.ai Flash троттлит
# запросы с контекстом >8K токенов, поэтому 8000 символов — безопасный запас.
MAX_CONTEXT_CHARS=8000

# Учитывать 8K‑лимит для GLM‑4.5‑Flash? Если true, история и общий
# контекст будут обрезаться до MAX_HISTORY_MESSAGES_PER_CHAT и
# MAX_CONTEXT_CHARS. Если false — лимит отключён, бот может пытаться
# отправлять более длинные запросы (что может вызвать throttling). Значения:
# true / false / 1 / 0.
RESPECT_GLM_8K_LIMIT=true

# Сеть
REQUEST_TIMEOUT=60
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_RESULTS_LIMIT=5
WEB_SEARCH_RESULTS_LIMIT_DOC=7

# Workspace (файлы юзеров)
WORKSPACE_TTL_HOURS=24
MAX_FILE_SIZE_MB=20
MAX_EXTRACTED_CHARS=200000

# Логи
LOG_LEVEL=INFO
