# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Optional: username without @ (auto-filled from getMe if empty)
BOT_USERNAME=

# ---- Access control (Telegram numeric user IDs) ----
# Your Telegram user id (owner bypass in groups). Get it from @userinfobot.
OWNER_USER_ID=
# Optional privileged co-user (VIP bypass). Leave empty if unused.
VIP_USER_ID=
# Comma-separated user IDs that get extra debug logging (defaults to OWNER_USER_ID)
DEBUG_USER_IDS=
# Optional comma-separated interest keywords for group context relevance
# GROUP_INTEREST_KEYWORDS=python,crypto,бот,нейросеть

# ---- OpenAI-compatible text model (required) ----
# Examples:
#   Z.ai GLM:  OPENAI_BASE_URL=https://api.z.ai/api/paas/v4
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=glm-4.5-flash

# ---- Optional separate Vision endpoint (images) ----
# Useful when text is GLM and vision is Gemini via OpenRouter / Google.
OPENAI_VISION_API_KEY=
OPENAI_VISION_BASE_URL=
OPENAI_VISION_MODEL=gemini-2.5-flash

# Fast / smart aliases used by /model (usually same as OPENAI_MODEL)
MODEL_FAST=glm-4.5-flash
MODEL_SMART=glm-4.5-flash

# Generation
MAX_TOKENS=1024
MAX_TOKENS_DOC=2048
TEMPERATURE=0.6

# Memory / context (important for free-tier GLM 8K)
HISTORY_ROUNDS=10
MAX_HISTORY_MESSAGES_PER_CHAT=5
MAX_CONTEXT_CHARS=8000
RESPECT_GLM_8K_LIMIT=true

# Group behavior
GROUP_PROACTIVE_MODE=false
GROUP_USER_COOLDOWN_SECONDS=5
GROUP_MAX_REQUESTS_PER_MINUTE=10
GROUP_CONTEXT_MESSAGES=10

# Network
REQUEST_TIMEOUT=60
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_RESULTS_LIMIT=5
WEB_SEARCH_RESULTS_LIMIT_DOC=7

# Workspace
WORKSPACE_TTL_HOURS=24
MAX_FILE_SIZE_MB=20
MAX_EXTRACTED_CHARS=200000

# Logging
LOG_LEVEL=INFO
